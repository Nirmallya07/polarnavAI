{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Time-Aware Risk Score",
  "description": "Contract for risk scores produced by the risk engine.",
  "type": "object",
  "properties": {
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "risk_level": {
      "type": "string",
      "enum": ["LOW", "MODERATE", "HIGH", "CRITICAL"]
    },
    "components": {
      "$ref": "#/$defs/component_scores"
    }
  },
  "required": [
    "timestamp_utc",
    "latitude",
    "longitude",
    "risk_score",
    "risk_level",
    "components"
  ],
  "additionalProperties": false,
  "$defs": {
    "component_scores": {
      "type": "object",
      "properties": {
        "sea_ice": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "iceberg": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "weather": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "ocean": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": ["sea_ice", "iceberg", "weather", "ocean"],
      "additionalProperties": false
    }
  }
}

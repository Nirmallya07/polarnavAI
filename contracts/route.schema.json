{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optimized Route",
  "description": "Contract for route optimization output returned by the route optimizer.",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["SAFE", "BALANCED", "FUEL_SAVER"]
    },
    "route": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route_point" }
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "distance_km": {
      "type": "number",
      "minimum": 0
    },
    "eta_hours": {
      "type": "number",
      "minimum": 0
    },
    "fuel_estimate": {
      "type": "number",
      "minimum": 0
    },
    "cost_score": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": ["mode", "route", "risk_score", "distance_km", "eta_hours", "fuel_estimate", "cost_score"],
  "additionalProperties": false,
  "$defs": {
    "route_point": {
      "type": "object",
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "arrival_time_utc": {
          "type": "string",
          "format": "date-time"
        },
        "risk_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "risk_level": {
          "type": "string",
          "enum": ["LOW", "MODERATE", "HIGH", "CRITICAL"]
        },
        "eta_hours": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["latitude", "longitude", "arrival_time_utc", "risk_score", "risk_level", "eta_hours"],
      "additionalProperties": false
    }
  }
}

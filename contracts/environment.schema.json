{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Environment Observation",
  "description": "Contract for environmental context returned by the environment service.",
  "type": "object",
  "properties": {
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "wind_u10": {
      "type": ["number", "null"]
    },
    "wind_v10": {
      "type": ["number", "null"]
    },
    "air_temperature": {
      "type": ["number", "null"]
    },
    "ocean_u": {
      "type": ["number", "null"]
    },
    "ocean_v": {
      "type": ["number", "null"]
    },
    "wave_height": {
      "type": ["number", "null"]
    },
    "wave_period": {
      "type": ["number", "null"]
    }
  },
  "required": [
    "timestamp_utc",
    "latitude",
    "longitude",
    "wind_u10",
    "wind_v10",
    "air_temperature",
    "ocean_u",
    "ocean_v",
    "wave_height",
    "wave_period"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sea Ice Prediction",
  "description": "Contract for sea-ice model output used by downstream risk evaluation.",
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1
    },
    "forecast_time_utc": {
      "type": "string",
      "format": "date-time"
    },
    "horizon_hours": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "grid": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/grid_point" }
    }
  },
  "required": ["model", "forecast_time_utc", "horizon_hours", "grid"],
  "additionalProperties": false,
  "$defs": {
    "grid_point": {
      "type": "object",
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "predicted_concentration": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": ["latitude", "longitude", "predicted_concentration"],
      "additionalProperties": false
    }
  }
}
